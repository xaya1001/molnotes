#!/usr/bin/env bash
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

if [[ ! -x node_modules/.bin/lint-staged ]]; then
  printf 'pre-commit dependencies are missing; run npm ci\n' >&2
  exit 1
fi

node scripts/check-staged-files.ts --staged
node scripts/check-private-terms.ts --staged
npm run format:staged
git diff --cached --check

                    },
                    {
                      "name": "甲醇",
                      "smiles": "CO",
                      "number": "6"
                    }
                  ],
                  "products": [
                    {
                      "name": "苯甲酸甲酯",
                      "smiles": "COC(=O)c1ccccc1",
                      "number": "4"
                    }
                  ],
                  "reagents": ["H⁺"],
                  "conditions": ["MeOH", "回流，4 h"],
                  "yield": "82%",
                  "explanation": "羧酸与甲醇形成甲酯；同一反应的多个反应物用加号连接。"
                },
                {
                  "title": "酯到酰胺",
                  "reactants": [
                    {
                      "name": "苯甲酸甲酯",
                      "smiles": "COC(=O)c1ccccc1",
                      "number": "4"

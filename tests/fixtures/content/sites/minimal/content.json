                  "reagents": ["NH₃"],
                  "conditions": ["MeOH", "50 °C，6 h"],
                  "yield": "78%",
                  "explanation": "比较酯与酰胺，保留苯甲酰骨架。"
                }
              ]
            },
            {
              "id": "retro",

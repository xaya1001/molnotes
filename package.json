{
  "name": "molnotes",
  "private": true,
  "engines": {
    "node": ">=26"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "worktree:setup": "node scripts/worktree-setup.ts",
    "site:new": "node scripts/new-site.ts",
    "patent:inventory": "node scripts/patent-inventory.ts",
    "patent:search": "node scripts/patent-search.ts",
    "check": "node --test tests/*.test.ts && node scripts/check-staged-files.ts --tracked && golar typecheck",
    "build": "vite build",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "video:render": "remotion render toolbox/video/entry.ts ProximityDemo public/showcase/explainer.mp4 --codec h264 --concurrency 2",
    "format:check": "prettier --check . --cache --cache-strategy content",
    "format:staged": "lint-staged",
    "hooks:install": "bash scripts/install-git-hooks.sh",
    "serve": "node server/web/web.ts",
    "content": "node scripts/content.ts",
    "content:preview": "node scripts/preview.ts",
    "molecule:layout": "node scripts/layout.ts",
    "figure:draw": "node scripts/figure-draw.ts",
    "figure:lint": "node scripts/figure-lint.ts",
    "figure:compile": "node scripts/figure-compile.ts",
    "figure:compare": "node scripts/figure-compare.ts",
    "figure:render": "node scripts/figure-render.ts",
    "figure:templates": "node scripts/figure-templates.ts"
  },
  "dependencies": {
    "@fontsource/noto-serif-sc": "5.3.1",
    "@rdkit/rdkit": "2026.9.1",
    "3dmol": "2.5.5",
    "echarts": "6.1.0",
    "fontkit": "2.0.4",
    "katex": "0.19.1",
    "markdown-it": "15.0.3",
    "markdown-it-cjk-friendly": "3.0.0",
    "motion-v": "2.8.0",
    "reka-ui": "2.11.0",
    "svg-parser": "2.1.0",
    "svg-path-properties": "2.2.0",
    "svgpath": "2.6.0",
    "vue": "3.5.44",
    "vue-router": "5.4.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@fontsource/arimo": "5.3.0",
    "@fontsource/noto-sans-sc": "5.3.1",
    "@fontsource/roboto": "5.3.0",
    "@golar/vue": "0.1.11",
    "@playwright/test": "1.64.1",
    "@remotion/cli": "4.0.538",
    "@types/fontkit": "2.0.9",
    "@types/katex": "0.16.8",
    "@types/node": "26.6.5",
    "@types/svg-parser": "2.0.6",
    "@vitejs/plugin-vue": "6.0.10",
    "golar": "0.1.11",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.538",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "lint-staged": {
    "*.{css,html,js,json,md,ts,vue,yaml,yml}": "prettier --write"
  }
}

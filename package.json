{
  "name": "molnotes",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "worktree:setup": "node scripts/worktree-setup.mjs",
    "site:new": "node scripts/new-site.mjs",
    "patent:inventory": "node scripts/patent-inventory.mjs",
    "patent:search": "node scripts/patent-search.mjs",
    "check": "node --test tests/*.test.mjs && node scripts/check-staged-files.mjs --tracked && golar typecheck",
    "build": "vite build",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "video:render": "remotion render toolbox/video/entry.ts ProximityDemo public/showcase/explainer.mp4 --codec h264 --concurrency 2",
    "format:check": "prettier --check . --cache --cache-strategy content",
    "format:staged": "lint-staged",
    "hooks:install": "bash scripts/install-git-hooks.sh",
    "serve": "node server/web.mjs",
    "content": "node scripts/content.mjs",
    "content:preview": "node scripts/preview.mjs",
    "molecule:layout": "node scripts/layout.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1156.0",
    "@fontsource/noto-serif-sc": "5.3.1",
    "@rdkit/rdkit": "2026.9.1",
    "3dmol": "2.5.5",
    "echarts": "6.1.0",
    "katex": "0.19.0",
    "markdown-it": "14.1.0",
    "markdown-it-cjk-friendly": "3.0.0",
    "motion-v": "2.8.0",
    "pg": "8.23.1",
    "reka-ui": "2.11.0",
    "vue": "3.5.44",
    "vue-router": "5.4.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@golar/vue": "0.1.11",
    "@playwright/test": "1.64.1",
    "@remotion/cli": "4.0.538",
    "@types/katex": "0.16.8",
    "@types/node": "26.6.5",
    "@vitejs/plugin-vue": "6.0.10",
    "golar": "0.1.11",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.538",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "lint-staged": {
    "*.{css,html,js,json,md,mjs,ts,vue,yaml,yml}": "prettier --write"
  }
}
